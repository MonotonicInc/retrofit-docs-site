#!/usr/bin/env bash
#
# The left navigation against the manifest, checked on what the site
# renders. For every page the manifest names, and the home page:
#
#   - the navigation lists every manifest page, in manifest order, under
#     its section, and nothing else;
#   - every navigation entry resolves to a page in the build;
#   - on a manifest page, exactly one entry is active, and it is that page.
#
# Usage: scripts/check-nav [build-dir]   (default: public, after `make build`)
# The manifest is read from _tree/manifest.json.

set -euo pipefail
cd "$(dirname "$0")/.."

BUILD="${1:-public}"
MANIFEST="_tree/manifest.json"

[ -f "$MANIFEST" ] || { echo "check-nav: no $MANIFEST; run make tree" >&2; exit 1; }
[ -f "$BUILD/index.html" ] || { echo "check-nav: no build in $BUILD; run make build" >&2; exit 1; }

python3 -I - "$BUILD" "$MANIFEST" <<'PY'
import json, os, sys
from html.parser import HTMLParser

build, manifest = sys.argv[1], sys.argv[2]
m = json.load(open(manifest))

# Expected: (section title, [(url, title)]) in order.
want = [(s["title"], [("/" + p["path"][:-3] + "/", p["title"]) for p in s["pages"]])
        for s in m["sections"]]

class Nav(HTMLParser):
    """Collects the sections and links inside aside.book-menu's <nav>."""
    def __init__(self):
        super().__init__()
        self.depth = 0          # element depth inside aside.book-menu
        self.sections = []      # [(title, [(href, text, active)])]
        self.span = None
        self.link = None
    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if self.depth == 0:
            if tag == "aside" and "book-menu" in (a.get("class") or "").split():
                self.depth = 1
            return
        if tag not in ("br", "img", "input", "meta", "link"):
            self.depth += 1
        if tag == "span":
            self.span = ""
        elif tag == "a":
            self.link = [a.get("href"), "", "active" in (a.get("class") or "").split()]
    def handle_endtag(self, tag):
        if self.depth == 0:
            return
        if tag == "span" and self.span is not None:
            self.sections.append((self.span.strip(), []))
            self.span = None
        elif tag == "a" and self.link is not None:
            if not self.sections:
                self.sections.append((None, []))
            self.sections[-1][1].append((self.link[0], self.link[1].strip(), self.link[2]))
            self.link = None
        self.depth -= 1
    def handle_data(self, data):
        if self.span is not None:
            self.span += data
        if self.link is not None:
            self.link[1] += data

def resolves(href):
    return href and href.startswith("/") and os.path.isfile(os.path.join(build, href.lstrip("/"), "index.html"))

failures = []
pages = [("/", None)] + [(u, u) for _, ps in want for u, _ in ps]
for url, self_url in pages:
    f = os.path.join(build, url.lstrip("/"), "index.html")
    if not os.path.isfile(f):
        failures.append(f"{url}: no page in the build")
        continue
    nav = Nav()
    nav.feed(open(f, encoding="utf-8").read())
    got = [(t, [(h, x) for h, x, _ in ls]) for t, ls in nav.sections]
    if got != want:
        first = next((i for i, (w, g) in enumerate(zip(want, got)) if w != g), min(len(want), len(got)))
        w = want[first] if first < len(want) else None
        g = got[first] if first < len(got) else None
        failures.append(f"{url}: navigation does not match the manifest at section {first}\n    want {w}\n    got  {g}")
    for _, ls in nav.sections:
        for h, _, _ in ls:
            if not resolves(h):
                failures.append(f"{url}: navigation entry {h!r} does not resolve")
    active = [h for _, ls in nav.sections for h, _, a in ls if a]
    if self_url is not None and active != [self_url]:
        failures.append(f"{url}: active entries {active}, want [{self_url!r}]")
    if self_url is None and active:
        failures.append(f"{url}: active entries {active}, want none")

if failures:
    print("check-nav: FAIL", file=sys.stderr)
    for x in failures:
        print("  " + x, file=sys.stderr)
    sys.exit(1)
n = sum(len(ps) for _, ps in want)
print(f"check-nav: ok ({len(want)} sections, {n} entries, {len(pages)} pages checked)")
PY
